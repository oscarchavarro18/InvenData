# Plantilla del .env de PRODUCCIÓN. En el servidor: cp .env.prod.example .env y complete.
# El .env real nunca se sube a Git ni se comparte por chat.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Genere una clave propia con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=inventario.ejemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://inventario.ejemplo.com
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS obliga al navegador a usar HTTPS. Empiece con una hora; suba a 31536000 (un año)
# cuando haya comprobado que HTTPS funciona bien.
DJANGO_HSTS_SECONDS=3600

# --- PostgreSQL (el host "db" es el servicio de docker-compose.prod.yml) ---
POSTGRES_DB=invendata
POSTGRES_USER=invendata
# Una contraseña larga y aleatoria: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- HTTPS ---
DOMINIO=inventario.ejemplo.com
CORREO_CERTIFICADOS=sistemas@ejemplo.com

# --- Gunicorn (procesos que atienden peticiones; 2 x núcleos + 1 es una buena regla) ---
GUNICORN_WORKERS=3
