# Copie este archivo a ".env" y ajuste los valores. El archivo ".env" NO se sube a Git.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambie-esta-clave-solo-para-desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (el host "db" es el nombre del servicio en docker-compose) ---
POSTGRES_DB=invendata
POSTGRES_USER=invendata
POSTGRES_PASSWORD=invendata_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
